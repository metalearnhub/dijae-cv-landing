{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/",
   "has": [
    {
     "type": "host",
     "value": "crm.dijaedadula.com"
    }
   ],
   "destination": "/crm",
   "permanent": false
  }
 ],
 "rewrites": [
  {
   "source": "/px/:path*",
   "destination": "https://statics.pancake.vn/:path*"
  }
 ]
}